# Copy to .env (git-ignored) before `docker compose up`, and set your own values.
# Generate secrets with e.g. `openssl rand -base64 48`.

# Postgres password used by both the database and the API connection string.
POSTGRES_PASSWORD=

# Signing key for JWTs. Use a long random string (32+ chars).
JWT_KEY=

# Password for the bootstrap HR/Executive accounts seeded on an empty database
# (hr.admin@acmehr.local / exec.admin@acmehr.local). Leave empty to skip seeding them.
# Must satisfy the Identity password policy (upper, lower, digit, symbol).
SEED_BOOTSTRAP_PASSWORD=
